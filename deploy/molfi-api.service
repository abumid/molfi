# The API service. The Telegram bot and the daily jobs (boarding accrual,
# marking overdue payments) live inside this same process — index.js starts
# them itself, so no separate services or cron entries are needed.
#
# Install:
#   sudo cp deploy/molfi-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now molfi-api
#
# Logs: journalctl -u molfi-api -f

[Unit]
Description=Molfi API
Documentation=https://github.com/abumid/molfi
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ai
WorkingDirectory=/home/ai/molfi/server
ExecStart=/usr/bin/node src/index.js
EnvironmentFile=/home/ai/molfi/server/.env

# Restart on failure, but not in an endless carousel: if the process dies right
# after start five times in a minute, systemd stops and that is visible in the
# status instead of drowning in the logs
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# The bot holds a long poll to Telegram; give it time to close on shutdown
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal
SyslogIdentifier=molfi-api

# The process should be able to do nothing beyond its own job
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ai/molfi/server
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
