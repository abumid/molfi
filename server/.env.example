# Скопируйте этот файл в .env и заполните значения.
# Сам .env в git не попадает — он в .gitignore.

# development включает подсказки: код подтверждения печатается в лог,
# если ни Telegram, ни SMS не настроены. На боевом ставьте production.
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=molfi
DB_USER=postgres
DB_PASSWORD=

# Подпись токенов. Смените на длинную случайную строку:
#   openssl rand -base64 48
# Со сменой этого значения разлогинятся все пользователи.
JWT_SECRET=change_me

# Токен бота от @BotFather. Без него коды уходят только по SMS.
BOT_TOKEN=

# Адрес мини-приложения, куда бот ведёт кнопкой «Открыть»
WEBAPP_URL=https://molfi.uz

# Шлюз SMS eskiz.uz. Оба поля пустые — SMS не отправляются,
# и в development код можно взять из лога сервера.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
