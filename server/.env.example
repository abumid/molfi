# Copy this file to .env and fill in the values.
# The .env itself is not committed — it is in .gitignore.

# development turns on hints: the confirmation code is printed to the log when
# neither Telegram nor SMS is configured. Use production on the live server.
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=molfi
DB_USER=postgres
DB_PASSWORD=

# Token signing. Change this to a long random string:
#   openssl rand -base64 48
# Changing this value signs every user out.
JWT_SECRET=change_me

# Bot token from @BotFather. Without it codes go out over SMS only.
BOT_TOKEN=

# Address of the mini app the bot opens with its button
WEBAPP_URL=https://molfi.uz

# eskiz.uz SMS gateway. With both fields empty no SMS is sent, and in
# development the code can be taken from the server log.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
